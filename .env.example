# Copy to .env for local dev (already gitignored). On Vercel, set the same
# names as Environment Variables in the project settings instead.

# Required everywhere — HTTP Basic Auth credentials that gate the whole app.
APP_USERNAME=souhaib
APP_PASSWORD=

# Only needed for production (Vercel). Leave unset locally — the app then
# falls back to a local SQLite file at data/dashboard.db automatically.
#
# The Turso CLI needs WSL on Windows, so use the web dashboard instead:
# 1. Sign in at https://app.turso.tech and click "Create Database".
# 2. Open the database's "Connect" tab and copy the libsql://... URL
#    -> TURSO_DATABASE_URL
# 3. On the same page, generate a token (shown once)
#    -> TURSO_AUTH_TOKEN
# 4. Add both as Environment Variables in the Vercel project settings, or via:
#    npx vercel env add TURSO_DATABASE_URL production,preview,development --value "<url>" --yes
#    npx vercel env add TURSO_AUTH_TOKEN production,preview,development --value "<token>" --yes
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
