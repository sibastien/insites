# Copy to .env for local dev (already gitignored). On Vercel, set the same
# names as Environment Variables in the project settings instead.

# Required everywhere — HTTP Basic Auth credentials that gate the whole app.
APP_USERNAME=souhaib
APP_PASSWORD=

# Only needed for production (Vercel). Leave unset locally — the app then
# falls back to a local SQLite file at data/dashboard.db automatically.
#
# 1. Install the Turso CLI and run: turso db create dashboard-souhaib
# 2. turso db show dashboard-souhaib --url        -> TURSO_DATABASE_URL
# 3. turso db tokens create dashboard-souhaib      -> TURSO_AUTH_TOKEN
# 4. Add both as Environment Variables in the Vercel project settings.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
